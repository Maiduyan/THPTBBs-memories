# ============================================================================
#  KỶ NIỆM THPT BẮC BÌNH — Biến môi trường
#  Thực hiện bởi Mai Duy An
#
#  HƯỚNG DẪN:
#  1. Copy file này thành ".env" (cùng thư mục với package.json).
#  2. Điền các giá trị thật, KHÔNG đưa file .env lên Git.
#  3. Khởi động lại `npm run dev` sau khi sửa biến môi trường.
#  4. Nếu bỏ trống toàn bộ, game vẫn chạy ở CHẾ ĐỘ DEMO:
#     kỷ niệm + ảnh được lưu tạm trong localStorage của trình duyệt.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Lấy tại: Supabase Dashboard -> Project Settings -> API
# (dùng Anon public key, TUYỆT ĐỐI không dùng service_role key ở frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Cloudinary -------------------------------------------------------------
# Lấy Cloud name tại: Cloudinary Dashboard -> Settings -> Upload
# Tạo Upload Preset: Settings -> Upload -> Add upload preset
#   + Signing Mode: Unsigned
#   + (tuỳ chọn) Folder: thptbb/memories
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=thptbb_unsigned

# Không bắt buộc: chỉ điền nếu Upload Preset của bạn cho phép truyền folder.
# Nếu Cloudinary báo lỗi "folder parameter is not allowed", hãy để trống.
# VITE_CLOUDINARY_FOLDER=thptbb/memories
